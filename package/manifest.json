{
  "manifest_version": 3,
  "name": "Send to Home Assistant",
  "version": "2026.10.2",
  "description": "Send the current page URL and title to your Home Assistant webhook.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to Home Assistant",
    "default_icon": {
      "16": "icon-256.png",
      "32": "icon-256.png",
      "48": "icon-256.png",
      "128": "icon-256.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon-256.png",
    "32": "icon-256.png",
    "48": "icon-256.png",
    "128": "icon-256.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self'; img-src 'self' data: https: http:; connect-src 'self' https: http:;"
  },
  "homepage_url": "https://github.com/JOHLC/Send-to-Home-Assistant",
  "short_name": "Send to HA",
  "author": "@JOHLC",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "minimum_chrome_version": "116",
  "version_name": "2026.10.2-Beta3"
}
